<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
    </PropertyGroup>

    <!--Publish Package START-->
    <PropertyGroup>
        <PackageId>LTs.Configurations</PackageId>
        <Version>10.0.0-preview6</Version>
        <Authors>LTsoft</Authors>
        <Description>LTs.Configurations</Description>
        <Copyright>Copyright 2026</Copyright>
        <RepositoryUrl>https://github.com/LTsoft-repo/LTs.Utils.git</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
    <!--Publish Package END-->

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15"/>
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LTs.DependencyInjections\LTs.DependencyInjections.csproj"/>
        <ProjectReference Include="..\LTs.Utils\LTs.Utils.csproj"/>
    </ItemGroup>

</Project>
